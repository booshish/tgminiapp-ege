{
  "name": "tochka-study-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run content:check",
    "build": "next build",
    "prebuild:pages": "npm run content:check",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/test-*.mjs",
    "content:check": "node scripts/content-report.mjs --check",
    "content:report": "node scripts/content-report.mjs",
    "content:seed": "node scripts/content-report.mjs --seed",
    "content:matrix": "node scripts/math-release-report.mjs",
    "content:stage": "node scripts/stage-foundation-candidates.mjs",
    "exam:release:check": "node scripts/exam-release-check.mjs"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.14",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  }
}
