[{"id":"remaining-20261027-083","examType":["ЕГЭ"],"subjectId":"chinese","level":null,"examYear":2027,"examVersionId":"ege-chinese-2027-draft","examNumber":19,"part":1,"topicId":"ege-chinese-n19","prototypeId":"ege-chinese-n19-original","title":"Числительные","prompt":"В учебном объявлении число участников нужно записать иероглифами. 活动开始前，老师数了人数：第一组有二十人，第二组有十五人，两组一共有___人。两组没有重复参加的人。Выберите запись общего количества. 1) 五十三 2) 三十 3) 三十五 4) 三百五十. Запишите номер ответа.","answerDisplay":"3","answerRule":{"type":"choices","value":"3","ordered":true},"answerFormat":"text","difficulty":"foundation","solution":[{"text":"20+15=35. Число 35 записывается 三十五: три десятка и пять единиц. 五十三 — 53, 三十 — 30, 三百五十 — 350."}],"source":{"kind":"author","label":"Авторская подготовительная тренировка по проекту модели 2027 · не официальный КИМ","revision":1},"provenance":{"source_type":"original","license":null,"permission":"created-for-project","author":"Точка · авторские материалы проекта","source_url":null,"creation_method":"original-individual-task","rights_status":"project-authorship-declared"},"scoring":{"status":"pending-official-verification","maxPrimaryScore":1},"requirementsReference":{"url":"https://pro-schools.ru/fipi/ege/spec/2027/kya-11-ege-2027-spec.pdf","pdfPage":10,"year":2027,"status":"draft-copy-reviewed"},"publication":{"id":"remaining-20261027-083","releaseStatus":"ready","provenance":{"sourceIds":["tochka-project-original"],"authorship":"project-original","sourceFiles":["scripts/remaining-generators.mjs","scripts/humanities-originals.mjs","scripts/language-originals.mjs"],"attribution":["Авторский материал проекта «Точка»","Справочные источники используются только для сверки фактов и правил."]},"validation":{"status":"automated-reviewed","checkedAt":"2026-10-27","evidence":["scripts/test-remaining-pilot.mjs","docs/remaining-pilot-review.json"]}}},{"id":"remaining-20261027-084","examType":["ЕГЭ"],"subjectId":"chinese","level":null,"examYear":2027,"examVersionId":"