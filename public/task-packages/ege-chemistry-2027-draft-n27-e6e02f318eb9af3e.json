[{"id":"science-stage-a-20261026-13","examType":["ЕГЭ"],"subjectId":"chemistry","level":null,"examYear":2027,"examVersionId":"ege-chemistry-2027-draft","examNumber":27,"part":1,"topicId":"ege-chemistry-n27","prototypeId":"ege-chemistry-n27-original","title":"Термохимия","prompt":"Реакция идёт по термохимическому уравнению 2H₂(г) + O₂(г) = 2H₂O(ж) + 572 кДж. Полностью прореагировали 16 г кислорода с избытком водорода. M(O₂)=32 г/моль. Сколько килоджоулей теплоты выделилось?","answerDisplay":"286","answerRule":{"type":"number","value":"286"},"answerFormat":"number","difficulty":"standard","solution":[{"text":"По уравнению один моль O₂ даёт 572 кДж. Прореагировало 16/32=0,5 моль O₂, поэтому выделилось 572·0,5=286 кДж."}],"source":{"kind":"author","label":"Авторская тренировка · проект структуры 2027, не официальный КИМ","revision":1},"provenance":{"source_type":"original","license":null,"permission":"created-for-project","author":"Точка · авторские материалы проекта","source_url":null,"creation_method":"original-individual-task","rights_status":"project-authorship-declared"},"scoring":{"status":"pending-official-verification","maxPrimaryScore":1},"requirementsReference":{"url":"https://pro-schools.ru/fipi/ege/spec/2027/hi-11-ege-2027-spec.pdf","pdfPage":9,"year":2027,"status":"draft-copy-reviewed"},"publication":{"id":"science-stage-a-20261026-13","releaseStatus":"ready","provenance":{"sourceIds":["tochka-project-original"],"authorship":"project-original","sourceFiles":["scripts/release-science-stage-a.mjs"],"attribution":["Авторский материал проекта «Точка»"]},"validation":{"status":"automated-reviewed","checkedAt":"2026-10-26","evidence":["scripts/release-science-stage-a.mjs","docs/science-stage-a-review.json"]}}},{"id":"science-stage-a-20261026-14","examType":["ЕГЭ"],"subjectId":"chemistry","level":null,"examYear":2027,"examVersionId":"ege-chemistry-2027-draft","examNumber":27,"part":1,"topicId":"ege-chemistry-n27","prototypeId":"ege-chemistry-n27-original","title":"Термохимия","prompt":"Для разложения одного моля CaCO₃ по уравнению CaCO₃(тв) = CaO(тв) + CO₂(г) требуется подвести 178 кДж теплоты. Какое количество теплоты нужно подвести для полного разложения 2,5 моль CaCO₃? Ответ в кДж, потери не учитывайте.","answerDisplay":"445","answerRule":{"type":"number","value":"445"},"answerFormat":"number","difficulty":"standard","solution":[{"text":"Удельный по количеству вещества расход теплоты — 178 кДж/моль. Для 2,5 моль требуется 178·2,5=445 кДж. Теплота поглощается, поэтому указывается положительная величина подведённой энергии."}],"source":{"kind":"author","label":"Авторская тренировка · проект структуры 2027, не официальный КИМ","revision":1},"provenance":{"source_type":"original","license":null,"permission":"created-for-project","author":"Точка · авторские материалы проекта","source_url":null,"creation_method":"original-individual-task","rights_status":"project-authorship-declared"},"scoring":{"status":"pending-official-verification","maxPrimaryScore":1},"requirementsReference":{"url":"https://pro-schools.ru/fipi/ege/spec/2027/hi-11-ege-2027-spec.pdf","pdfPage":9,"year":2027,"status":"draft-copy-reviewed"},"publication":{"id":"science-stage-a-20261026-14","releaseStatus":"ready","provenance":{"sourceIds":["tochka-project-original"],"authorship":"project-original","sourceFiles":["scripts/release-science-stage-a.mjs"],"attribution":["Авторский материал проекта «Точка»"]},"validation":{"status":"automated-reviewed","checkedAt":"2026-10-26","evidence":["scripts/release-science-stage-a.mjs","docs/science-stage-a-review.json"]}}}]