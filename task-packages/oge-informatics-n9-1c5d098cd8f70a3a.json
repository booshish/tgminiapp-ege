dAt":"2026-10-26","evidence":["scripts/release-task-pilot.mjs","docs/pilot-task-review.json"]}},"subjectId":"informatics","examType":["ОГЭ"],"level":null,"examNumber":9,"examYear":2027,"examVersionId":"oge-informatics-2027-draft","part":1,"topicId":"oge-informatics-n9","prototypeId":"oge-informatics-n9-original","title":"Схемы и пути","prompt":"В ориентированном графе разрешены только рёбра А→Б, А→В, Б→Г, В→Г, Г→Д, Г→Е, Д→Ж, Е→Ж, Б→Ж. Сколько путей из А в Ж проходят через Г?","answerDisplay":"4","answerRule":{"type":"number","value":"4"},"answerFormat":"number","difficulty":"standard","source":{"kind":"author","label":"Авторское задание · проект структуры ФИПИ 2027","revision":1},"provenance":{"source_type":"original","license":null,"permission":"created-for-project","author":"Точка · авторские материалы проекта","source_url":null,"creation_method":"original-individual-task","rights_status":"project-authorship-declared"},"scoring":{"status":"pending-official-verification","maxPrimaryScore":1},"solution":[{"text":"В Г ведут два пути: через Б и через В. Из Г в Ж два пути: через Д и через Е. Для каждой первой части можно выбрать любую вторую: 2 · 2 = 4. Ребро Б→Ж не проходит через Г."}]}]