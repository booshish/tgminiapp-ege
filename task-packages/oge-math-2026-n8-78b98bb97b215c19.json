[{"id":"multi-subject-20261026-02","examType":["ОГЭ"],"level":null,"examNumber":8,"legacyExamTypes":["ОГЭ","ЕГЭ"],"topicId":"powers-roots","prototypeId":"powers-and-roots","title":"Степени с одинаковым основанием · авторская пробная партия","prompt":"Вычислите значение выражения (a² − 36)/(a − 6) при a = 11.","answerRule":{"type":"number","value":"17"},"answerDisplay":"17","solution":[{"text":"a² − 36 = (a − 6)(a + 6). При a = 11 знаменатель не равен нулю, значение равно 11 + 6 = 17."}],"publication":{"id":"multi-subject-20261026-02","releaseStatus":"ready","provenance":{"sourceIds":["tochka-project-original"],"authorship":"project-original","sourceFiles":["scripts/multi-subject-originals.mjs"],"attribution":["Авторский материал проекта «Точка»"]},"validation":{"status":"automated-reviewed","checkedAt":"2026-10-26","evidence":["scripts/release-multi-subject.mjs","docs/multi-subject-review.json"]}},"provenance":{"source_type":"original","license":null,"permission":"created-for-project","author":"Точка · авторские материалы проекта","source_url":null,"creation_method":"original-individual-task","rights_status":"project-authorship-declared"},"subjectId":"math","examYear":2026,"examVersionId":"oge-math-2026","part":1,"difficulty":"standard","answerFormat":"number","source":{"kind":"author","label":"Оригинальная пробная тренировка · не задание реального КИМ","revision":1},"scoring":{"status":"project-config","maxPrimaryScore":1},"conditionLatex":"\\frac{a^2-36}{a-6},\\quad a=11"}]